<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 1 permission set. Every entry is requested through the guided permission flow
         (explanation screen first). Permissions for later phases are added in those phases. -->

    <!-- Special access: per-app foreground time. Granted by the user in Settings > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Special access: draw the hero block screen over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Runtime permission on Android 13+: focus-session and limit notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the blocker survive aggressive OEM battery managers. Play policy restricts this
         permission; see README "Play policy notes". -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- User-granted exact alarms (NOT USE_EXACT_ALARM, which Play reserves for alarm/calendar apps).
         Used to start/stop focus schedules on time. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Keeps the blocker alive. specialUse is declared with an explanation below and needs a Play Console
         declaration ("app blocker / digital wellbeing"). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Restart blocking after a reboot if the user had it on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Only used to download an updated detection-rules file, and only if this build was given a rules URL
         (BuildConfig.RULES_URL, empty by default). No identifiers or usage data are ever sent. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed to show real app names/icons and to detect launchers for usage stats (Android 11+
         package visibility). Screen-time and blocker apps are an allowed use on Play, but a
         declaration form is required in Play Console. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".FocusForceApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusForce">

        <!-- WorkManager is initialised by FocusForceApp (Hilt worker factory), not by the default startup hook. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground-app detection: window-state events only, no window content (see accessibility_service_config.xml). -->
        <service
            android:name=".service.FocusAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Full-screen hero block screen. Own task, not in Recents, never shown as the user's own destination. -->
        <activity
            android:name=".ui.block.BlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.FocusForce" />

        <service
            android:name=".service.BlockerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Digital wellbeing app blocker: keeps the user-chosen app blocking running and shows its status notification" />
        </service>

        <!-- Home-screen widgets (Glance), each drawn in the active hero's style -->
        <receiver android:name=".widget.TodayWidgetReceiver" android:exported="true" android:label="@string/widget_today_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver android:name=".widget.QuickFocusWidgetReceiver" android:exported="true" android:label="@string/widget_quick_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_info" />
        </receiver>
        <receiver android:name=".widget.PowerMeterWidgetReceiver" android:exported="true" android:label="@string/widget_meter_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_meter_info" />
        </receiver>

        <!-- Quick Settings tile: start/stop a focus set -->
        <service
            android:name=".service.FocusTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_focus"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <receiver android:name=".service.PomodoroAlarmReceiver" android:exported="false" />
        <receiver android:name=".service.ScheduleAlarmReceiver" android:exported="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
