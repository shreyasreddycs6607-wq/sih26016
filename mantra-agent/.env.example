# Copy to .env and fill in. Never commit the real .env — kiosk_key is a
# bearer secret, exactly as sensitive as an invite code or a JWT signing key.

BACKEND_URL=http://localhost:8000

# From POST /admin/kiosks, run once by an admin when this kiosk is set up.
# Shown exactly once in that response — if it's lost, an admin revokes this
# kiosk (POST /admin/kiosks/{id}/revoke) and registers a new one.
KIOSK_KEY=

# mock (default) or real. "real" talks to the Mantra MFS100 Client Service
# that MFS100Driver installs and runs as a Windows service — see README.md's
# "Switching to real hardware" section. That service must already be
# running (it auto-starts once the driver package is installed) and the
# scanner plugged in; this agent does not install or start it.
MFS100_MODE=mock

CAPTURE_TIMEOUT_MS=10000

# The frontend origin(s) allowed to call this agent from the browser.
# Comma-separated. Point this at whatever origin the officer's browser is
# actually served from — localhost during development, the deployed
# frontend's real URL once this kiosk is in production.
ALLOWED_ORIGINS=http://localhost:5173

PORT=8791
