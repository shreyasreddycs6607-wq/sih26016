rules_version = '2';

// FocusForce multiplayer rules. Default: everything is denied; only the paths below are open, each with the narrowest access
// that works. Explained line by line in docs/FIRESTORE.md. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----------------------------------------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(s, max) { return s is string && s.size() >= 2 && s.size() <= max; }
    function validHero(h) { return h in ['VECTOR', 'NOCTIS', 'DASH']; }
    function validRank(r) { return r in ['RECRUIT', 'CADET', 'GUARDIAN', 'SENTINEL', 'CHAMPION', 'LEGEND']; }
    // 6 characters from the readable alphabet used by the app (no 0/O, 1/I/L)
    function validCode(c) { return c is string && c.matches('^[A-HJKMNP-Z2-9]{6}$'); }
    function squadPath(squadId) { return /databases/$(database)/documents/squads/$(squadId); }
    function isMember(squadId) { return signedIn() && request.auth.uid in get(squadPath(squadId)).data.memberUids; }

    // ---- public profile: name, hero, rank, level, friend code, hide flag. No usage data exists anywhere in this database.
    match /profiles/{uid} {
      allow get: if signedIn();          // one profile at a time, so nobody can download the user list
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'hero', 'rank', 'level', 'friendCode', 'hideFromLeaderboards'])
        && request.resource.data.keys().hasAll(['displayName', 'hero', 'rank', 'level', 'friendCode', 'hideFromLeaderboards'])
        && validName(request.resource.data.displayName, 24)
        && validHero(request.resource.data.hero)
        && validRank(request.resource.data.rank)
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 500
        && validCode(request.resource.data.friendCode)
        // the friend code on the profile must be one this user registered
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == uid
        && request.resource.data.hideFromLeaderboards is bool;
      allow delete: if isOwner(uid);
    }

    // ---- friend codes: code -> uid. Look up one code at a time; cannot be listed or changed.
    match /friendCodes/{code} {
      allow get: if signedIn() && validCode(code);
      allow list: if false;
      allow create: if signedIn() && validCode(code)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;  // create = must not exist yet
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- private per-user data: which squad I am in, and my friends. Only I can read or write it.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['squadId'])
        && (!('squadId' in request.resource.data) || (request.resource.data.squadId is string && request.resource.data.squadId.size() <= 40));

      match /friends/{friendUid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && friendUid != uid
          && request.resource.data.keys().hasOnly(['addedAt']) && request.resource.data.addedAt == request.time;
        allow update: if false;
      }
    }

    // ---- squad codes: code -> squad id. Whoever has the code can find the squad; nobody can list them.
    match /squadCodes/{code} {
      allow get: if signedIn() && validCode(code);
      allow list: if false;
      // created in the same batch as the squad, by that squad's owner
      allow create: if signedIn() && validCode(code)
        && request.resource.data.keys().hasOnly(['squadId']) && request.resource.data.squadId is string
        && getAfter(squadPath(request.resource.data.squadId)).data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && get(squadPath(resource.data.squadId)).data.ownerUid == request.auth.uid;
    }

    match /squads/{squadId} {
      // The squad id is random and only reachable through the code, so a get is how joining checks size and membership.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'code', 'ownerUid', 'memberUids'])
        && validName(request.resource.data.name, 30)
        && validCode(request.resource.data.code)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if signedIn() && (
        // JOIN: add only myself, at most 12 members
        (!(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.size() <= 12
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids)
        ||
        // LEAVE: remove only myself; if I was the owner I may hand the squad to another remaining member
        (request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'ownerUid'])
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && (request.resource.data.ownerUid == resource.data.ownerUid
              || (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid in request.resource.data.memberUids)))
      );

      // the last member can close the squad
      allow delete: if signedIn() && resource.data.memberUids == [request.auth.uid];

      // presence: members see it; I can only write my own, with a timestamp close to server time
      match /presence/{uid} {
        allow read: if isMember(squadId);
        allow create, update: if isOwner(uid) && isMember(squadId)
          && request.resource.data.keys().hasOnly(['state', 'focusEndsAtMs', 'updatedAtMs'])
          && request.resource.data.state in ['IDLE', 'FOCUSING']
          && request.resource.data.focusEndsAtMs is int && request.resource.data.updatedAtMs is int
          && request.resource.data.updatedAtMs > request.time.toMillis() - 300000
          && request.resource.data.updatedAtMs < request.time.toMillis() + 300000;
        allow delete: if isOwner(uid);
      }

      // group focus session ("current"): any member can start one (server clock) or add themselves to it
      match /sessions/{sessionId} {
        allow read: if isMember(squadId);
        allow create, update: if isMember(squadId) && sessionId == 'current' && (
          (request.resource.data.keys().hasOnly(['startedBy', 'startedAt', 'focusMin', 'participants'])
            && request.resource.data.startedBy == request.auth.uid
            && request.resource.data.startedAt == request.time
            && request.resource.data.focusMin is int && request.resource.data.focusMin >= 5 && request.resource.data.focusMin <= 120
            && request.resource.data.participants == [request.auth.uid])
          ||
          (resource != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.participants.size() == resource.data.participants.size() + 1
            && request.resource.data.participants.hasAll(resource.data.participants))
        );
        allow delete: if isMember(squadId);
      }
    }

    // ---- weekly leaderboards: leaderboards/{ISO week}/entries/{uid}
    match /leaderboards/{week}/entries/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 100;   // pages of at most 100, never the whole collection
      allow create, update: if isOwner(uid) && week.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['displayName', 'hero', 'rank', 'score', 'updatedAt', 'expireAt'])
        && validName(request.resource.data.displayName, 24)
        && validHero(request.resource.data.hero)
        && validRank(request.resource.data.rank)
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 8000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expireAt is timestamp
        // a user who chose to hide cannot publish a score
        && get(/databases/$(database)/documents/profiles/$(uid)).data.hideFromLeaderboards == false;
      allow delete: if isOwner(uid);
    }
  }
}
